# Production env for Railway (Service → Variables). Never commit real values.

# Railway injects PORT automatically; keep unset unless overriding.
# CORS_ORIGINS: first entry is also used as the frontend base for
# NOWPayments success/cancel URLs, so put the public client origin first.
CORS_ORIGINS=https://app.thumbz.gg

DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=4

SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Public base URL of this API; used for the NOWPayments IPN callback.
PUBLIC_API_URL=https://<railway-service-domain>

# Production NOWPayments credentials (leave empty to disable ticket checkout).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_BASE=https://api.nowpayments.io
