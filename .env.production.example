# Production env for Railway (Service → Variables). Never commit real values.

# Railway injects PORT automatically; keep unset unless overriding.
NODE_ENV=production
CORS_ORIGINS=https://thumbz-next-client.vercel.app

# Public client URL (payment success/cancel pages). Required in production.
FRONTEND_URL=https://thumbz-next-client.vercel.app

# Railway terminates TLS in one proxy hop.
TRUST_PROXY=1
LOG_LEVEL=info
METRICS_TOKEN=<random 32+ chars>

# Railway Redis plugin: reference variable ${{Redis.REDIS_URL}}
REDIS_URL=

# Same value as the Vercel REVALIDATE_SECRET (frontend on-demand revalidation).
REVALIDATE_SECRET=<random 32+ chars>

DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=4

SUPABASE_JWKS_URL=https://qshjcszsvsgwpcgggkiv.supabase.co/auth/v1/.well-known/jwks.json

# Public base URL of this API; used for the NOWPayments IPN callback. Required.
PUBLIC_API_URL=https://thumbz-server-production.up.railway.app

# Production NOWPayments credentials (leave empty to disable ticket checkout).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_BASE=https://api.nowpayments.io

# Portfolio demo: simulate the seeded live matches (runs in the worker service).
LIVE_SIMULATOR=true

# Deploy two Railway services from this repo/image:
#   api    -> default start command (node dist/main.js), health check /health
#   worker -> start command: node dist/worker.js (same variables, no public port)

# Xendit (QRIS + VA). Webhook URL to register: ${PUBLIC_API_URL}/api/v1/webhooks/xendit
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# Portfolio demo without gateway accounts: keep true. A real shop: false.
PAYMENTS_SANDBOX=true
TICKET_SIGNING_SECRET=<random 32+ chars>

# --- Protected playback (DRM) ---
# 64 hex chars (32 bytes) sealing content keys at rest. Required in production.
# Generate: openssl rand -hex 32
DRM_MASTER_KEY=
# HMAC secret for playback tokens (>= 32 chars). Required in production.
PLAYBACK_TOKEN_SECRET=
MAX_STREAMS_PER_USER=2
# Optional commercial DRM (e.g. DoveRunner/PallyCon, EZDRM). Empty = ClearKey + HLS AES only.
DRM_WIDEVINE_LICENSE_URL=
DRM_PLAYREADY_LICENSE_URL=
DRM_FAIRPLAY_LICENSE_URL=
DRM_FAIRPLAY_CERT_URL=
