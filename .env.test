# Test environment (committed; local-only values). Jest never reads .env.
# Matches docker-compose.yml: Postgres on 44322, Redis on 6379.
NODE_ENV=test
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:44322/postgres
SUPABASE_JWKS_URL=https://test.supabase.local/auth/v1/.well-known/jwks.json
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
REDIS_URL=redis://127.0.0.1:6379
TICKET_SIGNING_SECRET=test-ticket-signing-secret-0123456789
