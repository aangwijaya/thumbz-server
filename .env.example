# Copy to .env and fill in real values. Never commit .env.

# HTTP port the NestJS API listens on (default 3001)
PORT=3001

# Supabase PostgreSQL connection string (server-side only).
# Cloud: session pooler URI (Connect tab) + pgbouncer=true. Do NOT wrap the
# password in [brackets]; the transaction pooler (:6543) breaks Prisma
# (prepared-statement errors) - use :5432 session pooler instead.
# Local fallback: postgresql://postgres:postgres@127.0.0.1:44322/postgres
DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=4

# Supabase Auth JWKS endpoint used to verify RS256 access tokens.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Comma-separated allowlist of browser origins for CORS.
CORS_ORIGINS=http://localhost:3000

# Browser-facing client URL (payment return pages). Required in production.
FRONTEND_URL=http://localhost:3000

# Reverse-proxy hops to trust for client IPs (rate limiting). 0 locally,
# 1 behind Railway's edge proxy.
TRUST_PROXY=0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Optional: when set (>= 16 chars), GET /metrics requires this bearer token.
METRICS_TOKEN=

# Redis (cache, rate limits, realtime fan-out, queues). docker-compose: redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379

# Optional: cache key prefix, so several environments can share one Redis.
CACHE_NAMESPACE=thumbz

# Optional: shared secret for POST {FRONTEND_URL}/api/revalidate (>= 16 chars).
# Must match REVALIDATE_SECRET in the Next.js app. Empty disables it.
REVALIDATE_SECRET=

# --- Ticketing / crypto payments (NOWPayments) ---
# Sandbox base by default; use https://api.nowpayments.io for production.
# Leave the key/secret empty to disable ticket checkout (503 on order create).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_BASE=https://api-sandbox.nowpayments.io

# Public base URL of THIS API (used for the provider IPN callback URL).
# Required in production.
PUBLIC_API_URL=http://localhost:3001

# Demo: keep seeded live matches "playing" (gold, kills, objectives) every N ms.
LIVE_SIMULATOR=false
LIVE_SIMULATOR_INTERVAL_MS=5000

# --- Indonesian payments (Xendit Payments API v3: QRIS + bank VA) ---
# Test-mode keys start with xnd_development_. Empty = QRIS/VA not offered.
XENDIT_SECRET_KEY=
# Dashboard → Webhooks → verification token (checked against x-callback-token).
XENDIT_CALLBACK_TOKEN=
XENDIT_API_BASE=https://api.xendit.co

# Demo/test only: built-in sandbox gateway + POST /me/payments/:id/simulate.
PAYMENTS_SANDBOX=true

# HMAC key for ticket QR payloads (>= 32 chars). Required in production.
TICKET_SIGNING_SECRET=

# --- Protected playback (DRM) ---
# 64 hex chars (32 bytes) sealing content keys at rest. Required in production.
# Generate: openssl rand -hex 32
DRM_MASTER_KEY=
# HMAC secret for playback tokens (>= 32 chars). Required in production.
PLAYBACK_TOKEN_SECRET=
MAX_STREAMS_PER_USER=2
# Optional commercial DRM (e.g. DoveRunner/PallyCon, EZDRM). Empty = ClearKey + HLS AES only.
DRM_WIDEVINE_LICENSE_URL=
DRM_PLAYREADY_LICENSE_URL=
DRM_FAIRPLAY_LICENSE_URL=
DRM_FAIRPLAY_CERT_URL=

# --- Web Push (match reminders) ---
# Generate once: npx web-push generate-vapid-keys. All three or none (none = push off).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
