# Copy to .env and fill in real values. Never commit .env.

# HTTP port the NestJS API listens on (default 3001)
PORT=3001

# Supabase PostgreSQL connection string (server-side only).
# Cloud: session pooler URI (Connect tab) + pgbouncer=true. Do NOT wrap the
# password in [brackets]; the transaction pooler (:6543) breaks Prisma
# (prepared-statement errors) - use :5432 session pooler instead.
# Local fallback: postgresql://postgres:postgres@127.0.0.1:44322/postgres
DATABASE_URL=postgresql://postgres:<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=4

# Supabase Auth JWKS endpoint used to verify RS256 access tokens.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Comma-separated allowlist of browser origins for CORS.
CORS_ORIGINS=http://localhost:3000
