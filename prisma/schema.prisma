// THUMBZ database schema (plan §6).
// All tables live in the `public` schema. UUIDs default to gen_random_uuid().
// The FK from profiles.id to auth.users is added in the init migration SQL
// (auth schema is Supabase-managed and not modeled here).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum user_role {
  user
  admin
}

enum tournament_status {
  upcoming
  ongoing
  completed
}

enum player_role {
  gold
  mid
  exp
  jungle
  roam
  flex
  coach
}

enum match_stage {
  group_stage
  regular_season
  playoffs
  semifinal
  third_place
  grand_final
}

enum match_status {
  scheduled
  live
  completed
  cancelled
  postponed
}

enum video_type {
  replay
  highlight
  vod
}

enum favorite_type {
  team
  player
}

enum match_item_phase {
  phase2
  phase3
}

model Profile {
  id         String    @id @db.Uuid
  username   String?   @unique
  avatar_url String?
  role       user_role @default(user)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  favorites    Favorite[]
  watchHistory WatchHistory[]
  comments     MatchComment[]
  ticketOrders TicketOrder[]
  tickets      Ticket[]

  @@map("profiles")
}

model Tournament {
  id          String            @id @default(uuid()) @db.Uuid
  slug        String            @unique
  name        String
  status      tournament_status @default(upcoming)
  region      String
  start_date  DateTime          @db.Date
  end_date    DateTime          @db.Date
  prize_pool  String?
  description String?
  logo_url    String?
  featured    Boolean           @default(false)
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt

  matches Match[]

  search_document Unsupported("tsvector")? @default(dbgenerated()) /// generated: see migration 20261008120000_search

  @@index([status, start_date(sort: Desc)])
  @@index([search_document], type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "tournaments_name_trgm_idx")
  @@map("tournaments")
}

model Team {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique
  name            String
  short_name      String?
  region          String
  logo_url        String?
  color_primary   String?
  color_secondary String?
  description     String?
  founded_year    Int?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  players             Player[]
  matchTeamA          Match[]                @relation("MatchTeamA")
  matchTeamB          Match[]                @relation("MatchTeamB")
  matchWon            Match[]                @relation("MatchWinner")
  teamStatistics      MatchTeamStatistic[]
  playerMatchStats    PlayerMatchStatistic[]
  MatchGoldSnapshot   MatchGoldSnapshot[]
  PlayerMatchSnapshot PlayerMatchSnapshot[]
  MatchItemEvent      MatchItemEvent[]
  MatchEvent          MatchEvent[]
  videosWon           Video[]                @relation("VideoWinner")

  search_document Unsupported("tsvector")? @default(dbgenerated()) /// generated: see migration 20261008120000_search

  @@index([name])
  @@index([search_document], type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "teams_name_trgm_idx")
  @@map("teams")
}

model Player {
  id         String      @id @default(uuid()) @db.Uuid
  slug       String      @unique
  nickname   String
  real_name  String?
  role       player_role
  country    String?
  team_id    String?     @db.Uuid
  photo_url  String?
  is_active  Boolean     @default(true)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  team                Team?                  @relation(fields: [team_id], references: [id], onDelete: SetNull)
  statistics          PlayerMatchStatistic[]
  PlayerMatchSnapshot PlayerMatchSnapshot[]
  MatchItemEvent      MatchItemEvent[]
  MatchEvent          MatchEvent[]

  search_document Unsupported("tsvector")? @default(dbgenerated()) /// generated: see migration 20261008120000_search

  @@index([team_id])
  @@index([nickname])
  @@index([search_document], type: Gin)
  @@index([nickname(ops: raw("gin_trgm_ops"))], type: Gin, map: "players_nickname_trgm_idx")
  @@map("players")
}

model Match {
  id                   String       @id @default(uuid()) @db.Uuid
  tournament_id        String?      @db.Uuid
  stage                match_stage?
  round                Int?
  group_name           String?
  best_of              Int          @default(1)
  game_number          Int?
  team_a_id            String       @db.Uuid
  team_b_id            String       @db.Uuid
  score_a              Int?
  score_b              Int?
  winner_team_id       String?      @db.Uuid
  status               match_status @default(scheduled)
  scheduled_at         DateTime
  started_at           DateTime?
  ended_at             DateTime?
  stream_url           String?
  thumbnail_url        String?
  viewer_count         Int          @default(0)
  featured             Boolean      @default(false)
  stream_delay_seconds Int          @default(30)
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt

  tournament          Tournament?            @relation(fields: [tournament_id], references: [id], onDelete: Restrict)
  teamA               Team                   @relation("MatchTeamA", fields: [team_a_id], references: [id], onDelete: Restrict)
  teamB               Team                   @relation("MatchTeamB", fields: [team_b_id], references: [id], onDelete: Restrict)
  winner              Team?                  @relation("MatchWinner", fields: [winner_team_id], references: [id], onDelete: Restrict)
  teamStatistics      MatchTeamStatistic[]
  playerStatistics    PlayerMatchStatistic[]
  videos              Video[]
  watchHistory        WatchHistory[]
  MatchGoldSnapshot   MatchGoldSnapshot[]
  PlayerMatchSnapshot PlayerMatchSnapshot[]
  MatchItemEvent      MatchItemEvent[]
  MatchEvent          MatchEvent[]
  broadcasts          MatchBroadcast[]
  comments            MatchComment[]
  ticketConfig        MatchTicketConfig?
  ticketOrders        TicketOrder[]
  tickets             Ticket[]

  @@index([status, scheduled_at])
  @@index([tournament_id, status])
  @@index([team_a_id])
  @@index([team_b_id])
  @@index([winner_team_id])
  @@map("matches")
}

model MatchTeamStatistic {
  id                    String @id @default(uuid()) @db.Uuid
  match_id              String @db.Uuid
  team_id               String @db.Uuid
  kills                 Int    @default(0)
  deaths                Int    @default(0)
  assists               Int    @default(0)
  gold                  Int    @default(0)
  towers_destroyed      Int    @default(0)
  game_duration_seconds Int?
  details               Json   @default("{}")

  match Match @relation(fields: [match_id], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [team_id], references: [id], onDelete: Restrict)

  @@unique([match_id, team_id])
  @@index([team_id])
  @@map("match_team_statistics")
}

model PlayerMatchStatistic {
  id           String  @id @default(uuid()) @db.Uuid
  match_id     String  @db.Uuid
  player_id    String  @db.Uuid
  team_id      String  @db.Uuid
  kills        Int     @default(0)
  deaths       Int     @default(0)
  assists      Int     @default(0)
  gold         Int     @default(0)
  damage       Int     @default(0)
  damage_taken Int     @default(0)
  level        Int?
  hero_picked  String?
  mvp          Boolean @default(false)
  details      Json    @default("{}")

  match  Match  @relation(fields: [match_id], references: [id], onDelete: Cascade)
  player Player @relation(fields: [player_id], references: [id], onDelete: Restrict)
  team   Team   @relation(fields: [team_id], references: [id], onDelete: Restrict)

  @@unique([match_id, player_id])
  @@index([player_id])
  @@index([team_id, match_id])
  @@map("player_match_statistics")
}

model Video {
  id               String     @id @default(uuid()) @db.Uuid
  match_id         String?    @db.Uuid
  title            String
  type             video_type
  url              String
  thumbnail_url    String?
  duration_seconds Int?
  game_number      Int?
  winning_team_id  String?    @db.Uuid
  published_at     DateTime   @default(now())
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  match       Match? @relation(fields: [match_id], references: [id], onDelete: SetNull)
  winningTeam Team?  @relation("VideoWinner", fields: [winning_team_id], references: [id], onDelete: Restrict)

  search_document Unsupported("tsvector")? @default(dbgenerated()) /// generated: see migration 20261008120000_search

  media MediaAsset?

  @@index([type, published_at(sort: Desc)])
  @@index([match_id])
  @@index([winning_team_id])
  @@index([published_at(sort: Desc)])
  @@index([search_document], type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "videos_title_trgm_idx")
  @@map("videos")
}

model Favorite {
  user_id     String        @db.Uuid
  entity_type favorite_type
  entity_id   String        @db.Uuid
  created_at  DateTime      @default(now())

  user Profile @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, entity_type, entity_id])
  @@index([entity_type, entity_id])
  @@map("favorites")
}

model WatchHistory {
  user_id          String   @db.Uuid
  match_id         String   @db.Uuid
  watched_at       DateTime @default(now())
  duration_seconds Int?
  total_seconds    Int?

  user  Profile @relation(fields: [user_id], references: [id], onDelete: Cascade)
  match Match   @relation(fields: [match_id], references: [id], onDelete: Cascade)

  @@id([user_id, match_id])
  @@index([user_id, watched_at(sort: Desc)])
  @@map("watch_history")
}

model MatchGoldSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  match_id    String   @db.Uuid
  team_id     String   @db.Uuid
  gold        Int      @default(0)
  recorded_at DateTime @default(now())

  match Match @relation(fields: [match_id], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [team_id], references: [id], onDelete: Restrict)

  @@unique([match_id, team_id, recorded_at])
  @@index([match_id, recorded_at])
  @@index([team_id])
  @@map("match_gold_snapshots")
}

model PlayerMatchSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  match_id     String   @db.Uuid
  player_id    String   @db.Uuid
  team_id      String   @db.Uuid
  kills        Int      @default(0)
  deaths       Int      @default(0)
  assists      Int      @default(0)
  gold         Int      @default(0)
  damage       Int      @default(0)
  damage_taken Int      @default(0)
  level        Int?
  recorded_at  DateTime @default(now())

  match  Match  @relation(fields: [match_id], references: [id], onDelete: Cascade)
  player Player @relation(fields: [player_id], references: [id], onDelete: Restrict)
  team   Team   @relation(fields: [team_id], references: [id], onDelete: Restrict)

  @@unique([match_id, player_id, recorded_at])
  @@index([match_id, recorded_at])
  @@index([player_id])
  @@index([team_id])
  @@map("player_match_snapshots")
}

model MatchItemEvent {
  id           String           @id @default(uuid()) @db.Uuid
  match_id     String           @db.Uuid
  player_id    String           @db.Uuid
  team_id      String           @db.Uuid
  item_id      String
  item_name    String
  phase        match_item_phase
  slot         Int?
  purchased_at DateTime         @default(now())

  match  Match  @relation(fields: [match_id], references: [id], onDelete: Cascade)
  player Player @relation(fields: [player_id], references: [id], onDelete: Restrict)
  team   Team   @relation(fields: [team_id], references: [id], onDelete: Restrict)

  @@unique([match_id, player_id, item_name, purchased_at])
  @@index([match_id, purchased_at])
  @@index([player_id])
  @@index([team_id])
  @@map("match_item_events")
}

model MatchEvent {
  id          String   @id @default(uuid()) @db.Uuid
  match_id    String   @db.Uuid
  team_id     String?  @db.Uuid
  player_id   String?  @db.Uuid
  event_type  String
  title       String
  details     Json     @default("{}")
  occurred_at DateTime @default(now())

  match  Match   @relation(fields: [match_id], references: [id], onDelete: Cascade)
  team   Team?   @relation(fields: [team_id], references: [id], onDelete: Restrict)
  player Player? @relation(fields: [player_id], references: [id], onDelete: Restrict)

  @@index([match_id, occurred_at])
  @@index([team_id])
  @@index([player_id])
  @@map("match_events")
}

enum broadcast_language {
  en
  id
  ms
  tl
}

model MatchBroadcast {
  id           String             @id @default(uuid()) @db.Uuid
  match_id     String             @db.Uuid
  language     broadcast_language
  stream_url   String
  viewer_count Int                @default(0)

  match Match @relation(fields: [match_id], references: [id], onDelete: Cascade)

  @@unique([match_id, language])
  @@map("match_broadcasts")
}

model MatchComment {
  id          String   @id @default(uuid()) @db.Uuid
  match_id    String   @db.Uuid
  user_id     String   @db.Uuid
  author_name String
  body        String
  created_at  DateTime @default(now())

  match   Match   @relation(fields: [match_id], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([match_id, created_at(sort: Desc)])
  @@index([user_id, created_at(sort: Desc)])
  @@map("match_comments")
}

enum ticket_order_status {
  pending
  paid
  cancelled
  expired
  failed
  refund_required
}

enum media_protection {
  none
  clearkey_aes
  multidrm
}

enum payment_provider {
  nowpayments
  xendit
  sandbox
}

enum payment_method {
  crypto
  qris
  va_bca
  va_bni
  va_bri
  va_mandiri
  va_permata
}

enum payment_status {
  pending
  succeeded
  failed
  expired
  cancelled
}

enum ticket_status {
  valid
  used
  void
}

model MatchTicketConfig {
  match_id       String    @id @db.Uuid
  venue_name     String
  venue_city     String?
  price_usd      Decimal   @db.Decimal(10, 2)
  /// Price for IDR methods (QRIS, bank VA); null = only crypto (USD) is offered.
  price_idr      Int?
  quota_total    Int
  sales_open_at  DateTime?
  sales_close_at DateTime?
  is_active      Boolean   @default(true)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  match Match @relation(fields: [match_id], references: [id], onDelete: Cascade)

  @@map("match_ticket_configs")
}

model TicketOrder {
  id                  String              @id @default(uuid()) @db.Uuid
  match_id            String              @db.Uuid
  user_id             String              @db.Uuid
  quantity            Int
  unit_price_usd      Decimal             @db.Decimal(10, 2)
  total_usd           Decimal             @db.Decimal(10, 2)
  status              ticket_order_status @default(pending)
  provider            String              @default("nowpayments")
  provider_payment_id String?             @unique
  invoice_url         String?
  expires_at          DateTime
  created_at          DateTime            @default(now())
  paid_at             DateTime?

  match    Match     @relation(fields: [match_id], references: [id], onDelete: Restrict)
  profile  Profile   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tickets  Ticket[]
  payments Payment[]

  @@index([match_id, status])
  @@index([user_id, created_at(sort: Desc)])
  @@map("ticket_orders")
}

model Ticket {
  id        String        @id @default(uuid()) @db.Uuid
  order_id  String        @db.Uuid
  match_id  String        @db.Uuid
  user_id   String        @db.Uuid
  /// 1..quantity within the order: (order_id, seq) unique makes double issuance impossible.
  seq       Int           @default(1)
  code      String        @unique
  status    ticket_status @default(valid)
  issued_at DateTime      @default(now())

  order   TicketOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  match   Match       @relation(fields: [match_id], references: [id], onDelete: Restrict)
  profile Profile     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([order_id, seq])
  @@index([user_id, issued_at(sort: Desc)])
  @@index([match_id])
  @@map("tickets")
}

/// One attempt to pay an order with a given method; an order may have several
/// (e.g. QRIS expired, then paid by BCA virtual account).
model Payment {
  id                 String           @id @default(uuid()) @db.Uuid
  order_id           String           @db.Uuid
  provider           payment_provider
  method             payment_method
  /// ISO 4217: USD for crypto, IDR for QRIS/VA.
  currency           String
  amount             Decimal          @db.Decimal(14, 2)
  status             payment_status   @default(pending)
  /// The provider's own id (NOWPayments invoice id, Xendit payment_request_id).
  provider_reference String?
  /// What the customer must do: { kind: redirect|qr|va, url?, qr_string?, va_number?, bank? }.
  action             Json?
  failure_reason     String?
  expires_at         DateTime
  paid_at            DateTime?
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  order  TicketOrder    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  events PaymentEvent[]

  @@index([order_id, created_at(sort: Desc)])
  @@index([status, created_at])
  @@map("payments")
}

/// Inbox of provider webhooks (and reconciliation results): deduplicated by
/// (provider, event_key), processed asynchronously, kept for audit.
model PaymentEvent {
  id           String           @id @default(uuid()) @db.Uuid
  provider     payment_provider
  event_key    String
  payment_id   String?          @db.Uuid
  /// Normalized: succeeded | failed | expired | pending.
  status       String
  amount       Decimal?         @db.Decimal(14, 2)
  currency     String?
  payload      Json
  received_at  DateTime         @default(now())
  processed_at DateTime?
  /// What processing did (e.g. "paid", "late_paid", "refund_required", "amount_mismatch").
  outcome      String?

  payment Payment? @relation(fields: [payment_id], references: [id], onDelete: SetNull)

  @@unique([provider, event_key])
  @@index([processed_at])
  @@map("payment_events")
}

/// A packaged (optionally encrypted) stream: DASH for MSE/EME browsers, HLS
/// for Safari/iOS. Segments live on the CDN; access is gated by the keys.
model MediaAsset {
  id                  String           @id @default(uuid()) @db.Uuid
  video_id            String?          @unique @db.Uuid
  title               String
  protection          media_protection @default(clearkey_aes)
  /// Absolute CDN URLs of the manifests.
  dash_url            String?
  hls_url             String?
  /// Content key id (32 hex chars) when encrypted.
  kid                 String?
  /// Content id registered with a commercial DRM provider, if any.
  provider_content_id String?
  duration_seconds    Int?
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt

  video Video?      @relation(fields: [video_id], references: [id], onDelete: SetNull)
  key   ContentKey? @relation(fields: [kid], references: [kid])

  @@map("media_assets")
}

/// Content encryption keys, stored encrypted (AES-256-GCM envelope with
/// DRM_MASTER_KEY); plaintext keys never touch the database.
model ContentKey {
  kid        String   @id
  ciphertext String
  iv         String
  auth_tag   String
  created_at DateTime @default(now())

  assets MediaAsset[]

  @@map("content_keys")
}
