# Production env for the Oracle Cloud VM. Copy to deploy/oracle/.env and
# fill in real values. Never commit deploy/oracle/.env.
#
# Lines marked CHANGE are required before the API will boot, or before
# HTTPS will work. Compose forces NODE_ENV=production, PORT=3001, and
# REDIS_URL=redis://redis:6379 for the api and worker services.

# --- Caddy (not read by Nest) ---
# Hostname only. No https:// and no path. Must match PUBLIC_API_URL below.
# CHANGE
API_DOMAIN=api.example.com
# Let's Encrypt account email (expiry notices). CHANGE
ACME_EMAIL=you@example.com

# Set to 1 to skip Caddy and publish the API on 127.0.0.1:3001 only
# (Cloudflare Tunnel). Leave unset for the normal Caddy + ports 80/443 setup.
# ORACLE_TUNNEL=1

# Redis data cap inside the container (BullMQ policy stays noeviction).
# Raise this in .env if the log says the instance is out of memory.
# REDIS_MAXMEMORY=384mb

# --- App ---
NODE_ENV=production

# CHANGE. Browser origin of the Next.js client. Comma-separate extra origins.
CORS_ORIGINS=https://thumbz-next-client.vercel.app

# CHANGE if the client is not the URL above. Payment return pages.
FRONTEND_URL=https://thumbz-next-client.vercel.app

# CHANGE. Public origin of THIS API. Must be https://API_DOMAIN.
# Xendit / NOWPayments callbacks and DRM license URLs are built from it.
PUBLIC_API_URL=https://api.example.com

# 1 = trust Caddy, or cloudflared when ORACLE_TUNNEL=1.
# 2 = Cloudflare's orange-cloud proxy in front of Caddy (two hops).
TRUST_PROXY=1

LOG_LEVEL=info

# Empty leaves GET /metrics public on the API hostname. Set 16+ random chars.
METRICS_TOKEN=

# Compose overwrites this for api and worker. Keep the in-network URL so a
# pasted Railway Redis URL cannot win by accident.
REDIS_URL=redis://redis:6379

CACHE_NAMESPACE=thumbz

# Same value as REVALIDATE_SECRET on the Next.js app. Empty disables it.
REVALIDATE_SECRET=

# CHANGE. Supabase session pooler, port 5432, not the transaction pooler
# (:6543) and not the direct db.<ref>.supabase.co host (IPv6-only; this VM
# may have no IPv6). Do not wrap the password in brackets.
# If the password contains $, write $$ so Compose does not eat it.
# Both the API and the worker use this URL (two pools). connection_limit=4
# each is a small footprint on the session pooler.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=4

# CHANGE. Supabase Auth JWKS. https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Production NOWPayments. Empty key/secret disables ticket checkout.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_BASE=https://api.nowpayments.io

# Portfolio demo: the worker keeps seeded live matches playing. A real
# shop should set this to false.
LIVE_SIMULATOR=true
LIVE_SIMULATOR_INTERVAL_MS=5000

# Xendit (QRIS + VA). Dashboard webhook URL (owner updates this by hand):
#   https://API_DOMAIN/api/v1/webhooks/xendit
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_API_BASE=https://api.xendit.co

# Portfolio demo without live gateway charges: true. A real shop: false.
PAYMENTS_SANDBOX=true

# CHANGE. Required in production. openssl rand -base64 32
TICKET_SIGNING_SECRET=

# CHANGE. Required in production. openssl rand -hex 32
DRM_MASTER_KEY=

# CHANGE. Required in production. openssl rand -base64 32
PLAYBACK_TOKEN_SECRET=

MAX_STREAMS_PER_USER=2

# Optional commercial DRM. Empty = ClearKey + HLS AES only.
DRM_WIDEVINE_LICENSE_URL=
DRM_PLAYREADY_LICENSE_URL=
DRM_FAIRPLAY_LICENSE_URL=
DRM_FAIRPLAY_CERT_URL=

# Web Push. All three or none (none = push off).
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
